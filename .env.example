# ============================================================
#  Alerte Baisse de Facturation — configuration
#  Copier ce fichier en « .env » puis renseigner les deux
#  premieres lignes. Le .env n'est jamais versionne.
# ============================================================

# ---- Oracle (obligatoire) ----
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=192.168.10.30
ORACLE_PORT=1521
ORACLE_SERVICE=Sigasnde

# ---- Perimetre ----
# Zones S_ZONE : 1 INTERIEUR, 2 NOUAKCHOTT, 3 NOUADHIBOU
ZONE_IDS=1,2,3

# ---- Profondeur d'historique, en mois ----
# 24 par defaut : il faut novembre et decembre de l'annee precedente
# pour que janvier et fevrier aient leur cycle N-2.
HISTORIQUE_MOIS=24

# ---- Watcher temps reel ----
# Intervalle entre deux lectures d'Oracle, en secondes.
WATCHER_INTERVAL_SEC=180
# Les factures et releves ne sont rechargees qu'un tick sur N.
WATCHER_FACTURES_TOUS_LES=10
# Factures des 2 cycles en cours rechargees a chaque passage (alerte
# immediate a l'emission). 0 si la requete pese trop sur Oracle.
WATCHER_FACTURES_COURANT=1
# 0 = ouvrir l'interface sans toucher a Oracle.
WATCHER_ACTIF=1

# ---- Paliers de gravite (couleur et tri seulement) ----
GRAVITE_MOYENNE_PCT=10
GRAVITE_FORTE_PCT=25

# ---- Alerte ROUGE : baisse de facturation ----
# 1 recommande : n'alerter que sur un secteur REELLEMENT FACTURE.
# Tant que les factures ne sont pas emises, le volume est incomplet.
ALERTE_BAISSE_EXIGE_FACTURE=1
# 0 recommande : un secteur a 40 % de saisie baisse mecaniquement.
ALERTER_PROVISOIRE=0

# ---- Alerte JAUNE : retard de facturation ----
# Colonne de PLANIFDETAILLE portant la date prevue de facturation.
# DATEDEBUTSEMAINE est le choix du dashboard de suivi temps reel.
# Mettre DATEDEBUTFACT si c'est cette colonne qui fait foi chez vous :
# les deux dates sont affichees cote a cote dans l'onglet Retards.
COLONNE_DEADLINE=DATEDEBUTSEMAINE
# Marge de l'adjoint avant la date prevue, en jours, selon la taille du
# secteur. Grille reprise de l'onglet Retards du dashboard.
# La marge sert a afficher la deadline du releveur. "Deadline proche"
# = la veille du jour J ; "en retard" des le jour J (non cloture).
DEADLINE_MARGE_SMALL=1
DEADLINE_MARGE_MEDIUM=2
DEADLINE_MARGE_LARGE=3
DEADLINE_MARGE_XLARGE=4
# Au-dela de ce % de saisie, un secteur non cloture est juge capable de
# finir a temps et n'alerte pas. Meme exemption que l'onglet Retards du
# dashboard.
SAISIE_AVANCEE_PCT=90
# Alerter aussi les secteurs sans planning. 0 recommande : l'absence de
# planning est un probleme de saisie du planning, pas de facturation.
ALERTER_SANS_PLANNING=0
# Bandeau jaune aussi la veille du jour J (deadline proche). 1 par defaut.
ALERTER_DEADLINE_PROCHE=1
# Alerter aussi les secteurs CLOTURES dont la date de facturation est
# passee sans facture emise. 0 recommande : la facturation est un
# traitement de masse qui suit la cloture de quelques jours. Ces secteurs
# restent visibles dans l'onglet, en "A facturer, date depassee".
ALERTER_FACTURATION_RETARD=0

# ---- API ----
BAISSE_API_PORT=8020
